{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"2026\uff0c\u4e5f\u5728\u7ee7\u7eed\u51fa\u53d1 <p>\u2014\u2014 JesseHT \u4e8e 2026 \u5e74 8 \u6708</p> <p>\u6b22\u8fce\u6765\u5230 JesseHT \u7684\u79d1\u7814\u535a\u5ba2</p>"},{"location":"2About_Me/","title":"\u4e2a\u4eba\u7b80\u4ecb","text":""},{"location":"1Experiment_Methods/","title":"\u5b9e\u9a8c\u65b9\u6cd5","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u201cMABR\u201d\u7cfb\u751f\u7269\u5b9e\u9a8c\u7684\u5b9e\u9a8c\u65b9\u6cd5</p> <ul> <li>\u4e3b\u8981\u76ee\u7684\u662f\u4e3a\u4e86\u5728\u505a\u5b9e\u9a8c\u7684\u65f6\u5019\u6253\u5f00\u624b\u673a\u7f51\u9875\u5c31\u80fd\u770b\u5230\u6e05\u6670\u7684\u5b9e\u9a8c\u65b9\u6cd5\u3002</li> <li>\u5982\u679c\u5e2e\u5230\u4e86\u540e\u6765\u7684\u4f60\uff0c\u6211\u5c06\u4e0d\u80dc\u8363\u5e78\u3002</li> </ul> <p>\u66f4\u65b0\u8bb0\u5f55</p> <ul> <li>\u957f\u671f\u8fd0\u884c\u76d1\u6d4b-</li> </ul>"},{"location":"1Experiment_Methods/Electrochemical_Workstation/Electrochemical_Workstation/","title":"\u7535\u5316\u5b66\u5de5\u4f5c\u7ad9","text":""},{"location":"1Experiment_Methods/Electrochemical_Workstation/Electrochemical_Workstation/#0","title":"0 \u786c\u4ef6\u5b89\u88c5\u4e0e\u5de5\u4f5c\u7ad9\u542f\u52a8","text":"<p>\u7535\u5316\u5b66\u5de5\u4f5c\u7ad9\u5171\u4e09\u6761\uff08\u7ec4\uff09\u7ebf\uff0c\u5206\u522b\u4e3a\u7535\u6e90\u7ebf\u3001\u6570\u636e\u7ebf\u548c\u5bfc\u7ebf\uff0c\u5206\u522b\u8fde\u63a5\u5230\u7535\u6e90\u3001\u7535\u8111\u548c\u5f85\u6d4b\u53cd\u5e94\u5668\u3002</p> \u7535\u5316\u5b66\u5de5\u4f5c\u7ad9\u80cc\u9762 <ul> <li>\u7eff\u8272\u4fdd\u62a4\u5957\u5bfc\u7ebf\u4e3a\u5de5\u4f5c\u7535\u6781</li> <li>\u7ea2\u8272\u4e3a\u5bf9\u7535\u6781</li> <li>\u767d\u8272\u4e3a\u53c2\u6bd4\u7535\u6781</li> </ul> <p>\u5176\u4e2d\uff0c\u53c2\u6bd4\u7535\u6781\u901a\u5e38\u7531\u53cd\u5e94\u5668\u6b63\u8d1f\u6781\u4ee5\u5916\u7684\u7535\u6781\u6765\u5145\u5f53\u3002</p> \u7535\u5316\u5b66\u5de5\u4f5c\u7ad9\u63a5\u7ebf <p>\u5bfc\u7ebf\u8fde\u63a5</p> <p>\u5bfc\u7ebf\u8fde\u63a5\u8fc7\u7a0b\u4e2d\uff0c\u5e94\u5f53\u5173\u6389\u53cd\u5e94\u5668\u539f\u6709\u7535\u6e90\uff0c\u5e76\u5173\u6389\u6405\u62cc\u5668\u7b49\uff0c\u51cf\u5c11\u6613\u5728\u6eb6\u6db2\u4f53\u7cfb\u4ea7\u751f\u6270\u52a8\u7684\u56e0\u7d20\u3002</p> \u7535\u5316\u5b66\u5de5\u4f5c\u7ad9\u6b63\u9762 <p>\u63a5\u7ebf\u5b8c\u6210\u540e\uff0c\u5e94\u5f53\u5148\u542f\u52a8\u7535\u5316\u5b66\u5de5\u4f5c\u7ad9\uff0c\u518d\u4ece\u7535\u8111\u4e0a\u6253\u5f00\u8f6f\u4ef6\u3002\u6309\u7167\u5982\u4e0b\u8def\u5f84\u8fdb\u884c\u786c\u4ef6\u68c0\u6d4b\uff0c\u542c\u5230\u201ctitak\u201d\u58f0\u5373\u4e3a\u6b63\u5e38\u3002</p> <p>Setup -- Hardware Test</p>"},{"location":"1Experiment_Methods/Electrochemical_Workstation/Electrochemical_Workstation/#1-cv","title":"1 \u5faa\u73af\u4f0f\u5b89\u6cd5\u2014\u2014CV","text":""},{"location":"1Experiment_Methods/Electrochemical_Workstation/Electrochemical_Workstation/#11","title":"1.1 \u57fa\u7840\u77e5\u8bc6","text":""},{"location":"1Experiment_Methods/Electrochemical_Workstation/Electrochemical_Workstation/#12","title":"1.2 \u64cd\u4f5c\u6b65\u9aa4","text":"<p>\u6d4b\u8bd5\u9879\u76ee\u9009\u62e9CV</p> <p>Setup -- Technique --&gt; CV -- OK</p> <p>\u8bbe\u7f6e\u53c2\u6570</p> <p>Setup -- Parameters</p> <p>\u84dd\u8272\u53c2\u6570\u5e94\u968f\u5b9e\u9645\u9700\u8981\u6539\u52a8\uff0c\u7ea2\u8272\u53c2\u6570\u4f3c\u4e4e\u4e0d\u600e\u4e48\u6539\u52a8\uff0c\u626b\u63cf\u901f\u5ea6\u548c\u7cbe\u5ea6\u4e24\u4e2a\u53c2\u6570\u5e94\u5f53\u8be6\u7ec6\u8c03\u6574\u3002\u5176\u4e2d\uff0c\u626b\u63cf\u6b21\u6570\u4f3c\u4e4e\u5c06\u626b\u63cf\u201c\u4e00\u5708\u201d\u8bb0\u4e3a\u4e24\u6b21\u3002</p> <p></p> <p>\u89c2\u6d4b\u7ed3\u679c</p> <p>\u524d\u9762\u4e00\u4e24\u5708\u626b\u63cf\u4e2d\uff0c\u8d77\u70b9\u548c\u7ec8\u70b9\u5f88\u96be\u95ed\u5408\uff0c\u4f46\u5dee\u8ddd\u4f1a\u8d8a\u6765\u8d8a\u5c0f\uff0c\u540e\u9762\u51e0\u5708\u95ed\u5408\u60c5\u51b5\u4f1a\u5f97\u5230\u6539\u5584\u3002</p>"},{"location":"1Experiment_Methods/Gas_Chromatography_Mass_Spectrometry/Gas_Chromatography_Mass_Spectrometry/","title":"Gas Chromatography Mass Spectrometry","text":"<p>\u6c14\u76f8\u8272\u8c31\u8d28\u8c31\u8054\u7528\uff08GC-MS\uff09\u6d4b\u8bd5\u65b9\u6cd5</p> <p>1 \u539f\u7406</p> <p>2 \u64cd\u4f5c\u65b9\u6cd5\u2014\u2014\u4ee5 6:2FTOH \u6d4b\u8bd5\u65b9\u6cd5\u4e3a\u4f8b</p> <p>2.1\u5f00\u673a\u524d\u68c0\u67e5\u5de5\u4f5c</p> <p>\u673a\u5668\u540e\u9762\u4e24\u4e2a\u6c14\u74f6\u5747\u5904\u4e8e\u6253\u5f00\u72b6\u6001</p> \u8f7d\u6c14 <p>\u6253\u5f00\u5439\u626b\u6355\u96c6\uff0c\u5f00\u5173\u5728\u88c5\u7f6e\u540e\u8eab\uff0c\u4eae\u7eff\u706f\u65f6\u5c31\u7eea</p>"},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/","title":"\u79bb\u5b50\u8272\u8c31","text":""},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/#1","title":"1 \u539f\u7406","text":""},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/#2","title":"2 \u64cd\u4f5c\u6b65\u9aa4","text":""},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/#21","title":"2.1 \u51c6\u5907\u8815\u52a8\u6cf5\u4e0e\u52a0\u8f7d\u65b9\u6cd5","text":"<p>\u8fdb\u5165\u8f6f\u4ef6\uff0c\u5728\u5bfc\u822a\u754c\u9762\u9009\u62e9\u201c\u5b9e\u65f6\u91c7\u96c6\u201d\u3002</p> \u5bfc\u822a\u754c\u9762 <p>\u5f00\u542f\u8bbe\u5907\uff0c\u70b9\u51fb\u4e0b\u9762\u4e24\u4e2a\u6309\u94ae\u3002</p> \u91c7\u96c6\u754c\u9762\u5de6\u4e0a\u89d2 <p>\u6b64\u65f6\u5f00\u59cb\u704c\u6cf5\uff0c\u7f13\u6162\u63d0\u5347\u79bb\u5b50\u8272\u8c31\u6cf5\u538b\uff0c\u5927\u591a\u65b9\u6cd5\u4e2d\u6d41\u901f\u4e3a1\u3002\u5148\u5c06\u6d41\u901f\u8bbe\u7f6e\u4e3a0.2\uff0c\u5f85\u5b9e\u65f6\u76d1\u6d4b\u754c\u9762\u7684\u6cf5\u538b\uff08Pump pressure;\u84dd\u7ebf\uff09\u8dd1\u5e73\u540e\uff0c\u63d0\u5347\u6d41\u901f\u4e3a0.4\uff0c\u91cd\u590d\u4e0a\u8ff0\u64cd\u4f5c\u5230\u6d41\u901f\u4e3a1\u4e3a\u6b62\u3002</p> \u8bbe\u7f6e\u6cf5\u538b <p>\u63a5\u4e0b\u6765\u5173\u6389\u5de6\u4e0a\u89d2\u201c\u5b9e\u65f6\u76d1\u6d4b\u201d\uff0c\u6253\u5f00\u5de6\u4fa7\u540d\u4e3a\u6c5f\u6d69\u5929\u7684\u6587\u4ef6\u5939\uff0c\u5728\u4e0b\u9762\u7684\u65b9\u6cd5\u5217\u8868\u4e2d\u627e\u5230\u201c\u9634\u79bb\u5b50\u68af\u5ea6\u4eea\u5668\u65b9\u6cd5\u524d\u4f4e0.1\u6d17\u8131\u201d\u65b9\u6cd5\uff0c\u53cc\u51fb\u540e\u70b9\u51fb\u9875\u9762\u53f3\u4fa7\u7684\u52a0\u8f7d\u65b9\u6cd5\uff0c\u518d\u6253\u5f00\u201c\u5b9e\u65f6\u76d1\u6d4b\u201d\u3002</p> <p>\u7b49\u5f85\u4fe1\u53f7\u7ebf\u8dd1\u5e73\u3002</p>"},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/#22","title":"2.2 \u88c5\u8f7d\u6837\u54c1\u4e0e\u521b\u5efa\u5e8f\u5217\u65b9\u6cd5","text":"<p>\u79bb\u5b50\u8272\u8c31\u7684\u8fdb\u6837\u5668\u5728\u6574\u4e2a\u88c5\u7f6e\u53f3\u4fa7\u3002</p> \u8fdb\u6837\u5668 <p>\u6253\u5f00\u7bb1\u95e8\u524d\u6ce8\u610f\u89c2\u5bdf\u8fdb\u6837\u9488\u4f4d\u7f6e\uff0c\u5728\u539f\u4f4d\u65f6\u65b9\u53ef\u6253\u5f00\u7bb1\u95e8\u3002\u6837\u54c1\u7684\u5b9e\u9645\u6446\u653e\u4f4d\u7f6e\u5e94\u5f53\u4e0e\u540e\u9762\u5e8f\u5217\u65b9\u6cd5\u4e2d\u4e00\u81f4\u3002</p> \u6837\u54c1\u76d8\u7f16\u53f7\u65b9\u5f0f <p>\u65b0\u5efa\u5e8f\u5217\u65b9\u6cd5\u6216\u8005\u5728\u539f\u6709\u5e8f\u5217\u65b9\u6cd5\u4e0a\u4fee\u6539\u3002</p> \u65b0\u5efa\u5e8f\u5217\u65b9\u6cd5 <p>\u6bcf\u6b21\u6d4b\u6837\u4e2d\uff0c\u901a\u5e38\u524d\u9762\u52a01-2\u4e2a\u7a7a\u767d\uff0c\u63a5\u4e0b\u6765\u662f\u81ea\u5df1\u7684\u6837\u54c1\uff0c\u518d\u52a01-2\u4e2a\u7a7a\u767d\uff0c\u6700\u540e\u52a0\u4e00\u4e2a\u505c\u6cf5\u3002\u6bcf\u4e2a\u6837\u54c1\u4e2d\u9700\u8981\u8bbe\u7f6e\u6837\u54c1\u76d8\u4f4d\u7f6e\u3001\u540d\u79f0\u3001\u4eea\u5668\u65b9\u6cd5\u3002</p> <p>\u5176\u4e2d\uff0c\u7a7a\u767d\u53ef\u4ee5\u8bbe\u7f6e\u4e3a\u201c\u9634\u79bb\u5b50\u68af\u5ea6\u4eea\u5668\u65b9\u6cd5\u524d\u4f4e0.1\u6d17\u8131\u201d\u65b9\u6cd5\uff0c\u56e0\u4e3a\u6211\u4eec\u7684\u65b9\u6cd5\u6d17\u8131\u6d53\u5ea6\u5f88\u4f4e\uff0c\u6e05\u6d17\u6548\u679c\u5e76\u4e0d\u597d\uff0c\u53ef\u4ee5\u5728\u5c06\u6e05\u6d17\u65b9\u6cd5\u8bbe\u7f6e\u4e3a\u7528\u4e8e\u6d4b\u8bd5\u5e38\u89c4\u9634\u79bb\u5b50\u7684\u201c15mM\u9634\u79bb\u5b50\u4eea\u5668\u65b9\u6cd5\u201d\u3002\u505c\u6cf5\u6709\u4e13\u7528\u65b9\u6cd5\u2014\u2014\u201c\u505c\u6cf5\u65b9\u6cd5\u201d\u3002\u793a\u4f8b\u5982\u4e0b\u3002</p> \u5e8f\u5217\u65b9\u6cd5\u793a\u4f8b <p>\u63a5\u4e0b\u6765\uff0c\u70b9\u51fb\u201c\u8fd0\u884c\u5e8f\u5217\u201d\u3002</p> \u8fd0\u884c\u5e8f\u5217 <p>\u6ce8\u610f\uff0c\u5982\u679c\u5f53\u524d\u5e8f\u5217\u6b63\u5728\u8fd0\u884c\uff0c\u5e94\u5f53\u5728\u521b\u5efa\u597d\u5e8f\u5217\u65b9\u6cd5\u540e\u6309\u7167\u4e0b\u9762\u8def\u5f84\u64cd\u4f5c\u3002</p> <p>1 \u5728\u201c\u5b9e\u65f6\u76d1\u6d4b\u201d\u754c\u9762\uff0c\u6253\u5f00\u201c\u5f53\u524d\u8fd0\u884c\u8fdb\u6837\u201d\uff0c\u82e5\u5f53\u524d\u5e8f\u5217\u6700\u540e\u4e00\u4e2a\u6837\u54c1\u4eea\u5668\u65b9\u6cd5\u4e3a\u201c\u505c\u6cf5\u65b9\u6cd5\u201d\uff0c\u53f3\u952e\u8be5\u6837\u54c1\uff0c\u5220\u9664\u3002</p> \u6dfb\u52a0\u5e8f\u5217 <p>2 \u5728\u201c\u5b9e\u65f6\u76d1\u6d4b\u201d\u754c\u9762\uff0c\u6253\u5f00\u201c\u5e8f\u5217\u961f\u5217\u201d\uff0c\u5728\u53f3\u952e-\u6dfb\u52a0\u5e8f\u5217\uff0c\u9009\u4e2d\u5f53\u524d\u76ee\u6807\u5e8f\u5217\u5373\u53ef\u3002</p>"},{"location":"1Experiment_Methods/Ion_Chromatography/Ion_Chromatography/#23","title":"2.3 \u67e5\u770b\u7ed3\u679c","text":"<p>\u53c2\u8003\u521b\u5efa\u903b\u8f91\u5e8f\u5217\u6559\u7a0b\u89c6\u9891\u3002</p>"},{"location":"2Mechine_Learning/","title":"\u673a\u5668\u5b66\u4e60","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u201c\u673a\u5668\u5b66\u4e60\u201d\u7684\u5b66\u4e60\u8fc7\u7a0b</p> <p>\u66f4\u65b0\u8bb0\u5f55</p>"},{"location":"4OS_and_Server/","title":"\u667a\u94fe\u5347\u7ea7","text":"<p>\u8bb0\u5f55\u5173\u4e8e\u8ba1\u7b97\u673a\u64cd\u4f5c\u7cfb\u7edf\u7684\u5b66\u4e60\u3001\u4e2a\u4eba\u670d\u52a1\u5668\u8fd0\u884c\u8bb0\u5f55\u548c\u4e00\u4e9b\u5176\u4ed6\u5947\u601d\u5999\u60f3~</p>"},{"location":"4OS_and_Server/1Personal_Server/1ServSSM/Serv_Shutdown_Startup_Maintenance/","title":"\u670d\u52a1\u5668\u5173\u505c\u542f\u52a8\u4e0e\u7ef4\u4fee","text":""},{"location":"4OS_and_Server/1Personal_Server/1ServSSM/Serv_Shutdown_Startup_Maintenance/#_2","title":"\u5173\u95ed\u987a\u5e8f","text":"<ol> <li>Ubuntu-Docker</li> </ol> <p>\u8fdb\u5165 Nextcloud \u8def\u5f84,\u5173\u505c</p> Bash<pre><code>cd Documents/nextcloud/\nsudo docker-compose stop\n</code></pre> <ol> <li>TrueNAS</li> </ol> Bash<pre><code>poweroff\n</code></pre> <ol> <li> <p>Win-WIFI</p> </li> <li> <p>Ubuntu-Lab\uff08\u5982\u6709\uff09</p> </li> <li> <p>Win-GAME\uff08\u5982\u6709\uff09</p> </li> <li> <p>Win-Lab</p> </li> <li> <p>\u4e0d\u5fc5\u624b\u52a8\u5173\u95ed\u7684\u7cfb\u7edf</p> <ol> <li>iStoreOS</li> </ol> </li> </ol>"},{"location":"4OS_and_Server/1Personal_Server/1ServSSM/Serv_Shutdown_Startup_Maintenance/#_3","title":"\u542f\u52a8\u987a\u5e8f","text":"<p>\u5f00\u673a\u540e\u81ea\u52a8\u8fdb\u5165 Win-Lab \u684c\u9762\uff0c\u6d4f\u89c8\u5668\u8fdb\u5165 PVE \u63a7\u5236\u53f0\uff1a<code>192.168.x.x:8006</code></p> <ol> <li> <p>\u81ea\u542f\u52a8\u7cfb\u7edf</p> <ol> <li>iStoreOS</li> <li>Win-Lab</li> <li>Win-WIFI</li> <li>TrueNAS</li> <li>Ubuntu-Docker</li> </ol> </li> <li> <p>TrueNAS</p> </li> </ol> <p>\u8fdb\u5165 Nextcloud \u8def\u5f84</p> Bash<pre><code>cd /mnt/DataPool/DataPool/nextcloud/\n</code></pre> <p>\u6dfb\u52a0\u7528\u6237\u548c\u7ec4 <code>www-data</code> Bash<pre><code>pw groupadd www-data -g 33\npw useradd www-data -g 33 -u 33\n</code></pre></p> <p>\u68c0\u67e5\u65b9\u5f0f</p> Bash<pre><code>ls -la /mnt/DataPool/DataPool/nextcloud/\n</code></pre> <p>\u7b2c\u4e00\u884c\u548c\u7b2c\u4e09\u884c\u5c06\u51fa\u73b0\u76f8\u5173\u6570\u636e</p> <ol> <li>Ubuntu-Docker</li> </ol> <p>\u8fdb\u5165 Nextcloud \u8def\u5f84</p> Bash<pre><code>cd Documents/nextcloud/\n</code></pre> <p>\u6302\u8f7d <code>nfs</code>\uff08<code>Ctrl+r</code> <code>nfs</code>\uff09</p> <p>\u547d\u4ee4\u4e2d\u95f4\u7684 IP \u5730\u5740\u5728 TrueNAS \u9996\u9875\uff0c\u6216\u8005\u6253\u5f00shell <code>IP a</code> \u67e5\u627e\uff08\u592a\u591a\uff0c\u770b\u4e0d\u61c2hhh...\uff09</p> Bash<pre><code>sudo mount -t nfs -o nfsvers=3 192.168.x.x:/mnt/DataPool/DataPool/nextcloud/data/ DataPool\n</code></pre> <p>\u542f\u52a8\uff01</p> Bash<pre><code>sudo docker-compose restart\n</code></pre> <p>\u6302\u8f7d SSH</p> <p>\u5e38\u89c1\u6302\u8f7d\u591a\u4e2a SSH\uff0c\u63a8\u8350\u6253\u5f00\u591a\u4e2a\u7ec8\u7aef\uff0c\u65b9\u4fbf\u68c0\u67e5\u54ea\u4e2a\u6302\u4e86</p> <p><code>ssh -NfR</code>\uff1a <code>f</code> \u662f\u540e\u53f0\u8fd0\u884c\uff0c\u4e00\u822c\u4e0d\u7528\u52a0\uff0c\u4fbf\u4e8e\u67e5\u770b\u62a5\u9519\u4fe1\u606f </p> <p><code>xxxx</code>\uff1a\u4e91\u670d\u52a1\u5668\u4e3b\u673a\u7aef\u53e3</p> <p><code>yyyy</code>\uff1a\u672c\u5730\u76d1\u542c\u7aef\u53e3</p> <p><code>zzz</code>\uff1a\u7528\u6237\u540d</p> <p><code>a.b.c.d</code>\uff1a\u4e91\u670d\u52a1\u5668\u4e3b\u673a\u516c\u7f51 IP</p> Bash<pre><code>ssh -NR xxxx:localhost:yyyy zzz@a.b.c.d\n</code></pre> <ol> <li>Ubuntu-Lab</li> </ol> <p>\u6302\u8f7d SSH\uff0c\u65b9\u6cd5\u540c\u4e0a</p>"},{"location":"4OS_and_Server/1Personal_Server/1ServSSM/Serv_Shutdown_Startup_Maintenance/#_4","title":"\u7ef4\u4fee","text":"<p>\u91cd\u542f\u540e\u5e38\u89c1 MySQL \u7684 IP \u53d8\u66f4</p> <p>\u8fdb\u5165 Ubuntu-Docker</p> <p>\u67e5\u8be2\u65b0 IP</p> Bash<pre><code>cd /Documents/nextcloud\nsudo docker inspect mysql | grep \"IPAddress\"\n</code></pre> <p>\u66f4\u6539\u914d\u7f6e</p> Bash<pre><code>sudo docker exec -it nextcloud /bin/bash\n#\u51fa\u73b0\u524d\u7f00 root@xxxx:var/www/html#\n#\u7ee7\u7eed\u8f93\u5165\nvim config/config.php\n#\u6b64\u65f6\u8fdb\u53bb\u6539\u6389IP\uff0c\u5b8c\u6210\u540e\u6309\u201cEsc\u201d\u952e\u786e\u4fdd\u5904\u4e8e\u666e\u901a\u6a21\u5f0f\n#\u6b63\u5e38\u65b9\u5f0f\u9000\u51favim :wq (\u4fdd\u5b58\u5e76\u9000\u51fa)\nexit\n#\u524d\u7f00\u6d88\u5931\nexit\n</code></pre>"},{"location":"4OS_and_Server/1Personal_Server/2NetDiskRcloneFix/rclone%E7%BD%91%E7%9B%98%E6%95%85%E9%9A%9C%E6%8E%92%E6%9F%A5%E4%B8%8E%E4%B8%B4%E6%97%B6%E4%BD%BF%E7%94%A8/","title":"rclone \u7f51\u76d8\u6545\u969c\u6392\u67e5\u4e0e\u4e34\u65f6\u4f7f\u7528","text":"<p>\u6362\u4e86\u65b0\u7535\u8111\u4e4b\u540e\uff0c\u9700\u8981\u628a\u539f\u6765\u7535\u8111\u7684\u6587\u4ef6\u6089\u6570\u4e0a\u4f20\u5230NextCloud\u7f51\u76d8\uff0c\u8fd9\u65f6\u5019\uff0c\u5927\u6587\u4ef6\u4f20\u8f93\u548c\u6570\u91cf\u7e41\u591a\u7684\u5c0f\u6587\u4ef6\u4f20\u8f93\u9700\u8981\u4e00\u4e2a\u7a33\u5b9a\u7684\u89e3\u51b3\u65b9\u6848\uff0c\u4f7f\u7528\u777f\u603b\u7684rClone Windows \u4f7f\u7528\u6559\u7a0b\u3002\u7136\u800c\uff0c\u6211\u7684\u4e2a\u4eba\u57df\u540d\u4e00\u76f4\u62d6\u7740\u5b89\u5168\u8bc1\u4e66\u6ca1\u5f04\uff0c\u4f7f\u7528\u8fc7\u7a0b\u4e2d\u6709\u4e00\u4e9b\u5c0f\u95ee\u9898\uff0c\u7528\u8fd9\u4e00\u6559\u7a0b\u505a\u4e34\u65f6\u65b9\u6848\u3002</p>"},{"location":"4OS_and_Server/1Personal_Server/2NetDiskRcloneFix/rclone%E7%BD%91%E7%9B%98%E6%95%85%E9%9A%9C%E6%8E%92%E6%9F%A5%E4%B8%8E%E4%B8%B4%E6%97%B6%E4%BD%BF%E7%94%A8/#_1","title":"\u6392\u67e5","text":"<ol> <li>\u547d\u4ee4\u884c\u6d4b\u8bd5\u7f51\u76d8</li> </ol> Batchfile<pre><code>rclone lsd \"serv.jesseht.fun:\" -vv\n</code></pre> <p>\u62a5\u9519\uff1a</p> Text Only<pre><code>tls: failed to verify certificate\nx509: certificate has expired or is not yet valid\n</code></pre> <p>\u8bf4\u660e rclone \u914d\u7f6e\u548c WebDAV \u5730\u5740\u5df2\u8bfb\u53d6\uff0c\u4f46\u670d\u52a1\u5668\u8bc1\u4e66\u5931\u6548\u3002</p> <ol> <li>\u4e34\u65f6\u8df3\u8fc7\u8bc1\u4e66\u6d4b\u8bd5</li> </ol> Batchfile<pre><code>rclone lsd \"serv.jesseht.fun:\" -vv --no-check-certificate\n</code></pre> <p>\u6210\u529f\u5217\u51fa\u7f51\u76d8\u76ee\u5f55\uff0c\u8bc1\u660e\uff1a</p> <ul> <li> <p>rclone \u914d\u7f6e\u6b63\u786e\uff1b</p> </li> <li> <p>WebDAV \u5730\u5740\u6b63\u786e\uff1b</p> </li> <li> <p>\u8d26\u53f7\u5bc6\u7801\u6709\u6548\uff1b</p> </li> <li> <p>Nextcloud \u670d\u52a1\u6b63\u5e38\uff1b</p> </li> <li> <p>\u552f\u4e00\u95ee\u9898\u662f\u670d\u52a1\u5668\u8bc1\u4e66\u3002</p> </li> </ul>"},{"location":"4OS_and_Server/1Personal_Server/2NetDiskRcloneFix/rclone%E7%BD%91%E7%9B%98%E6%95%85%E9%9A%9C%E6%8E%92%E6%9F%A5%E4%B8%8E%E4%B8%B4%E6%97%B6%E4%BD%BF%E7%94%A8/#_2","title":"\u89e3\u51b3","text":"<ol> <li>\u4e34\u65f6\u8bbe\u7f6e Rclone Browser</li> </ol> <p>\u6253\u5f00\uff1aRclone Browser \u2192 Preferences \u2192 General</p> <p>Default rclone options:</p> <p>\u5c06\u539f\u6765\u7684\uff1a<code>--fast-list</code></p> <p>\u6539\u6210\uff1a<code>--fast-list --no-check-certificate</code></p> <p>\u70b9\u51fb OK\uff0c\u5b8c\u5168\u9000\u51fa Rclone Browser\uff08\u5305\u62ec\u7cfb\u7edf\u6258\u76d8\uff09\uff0c\u7136\u540e\u91cd\u65b0\u542f\u52a8\u3002</p> <p>\u5b89\u5168\u63d0\u9192</p> <p><code>--no-check-certificate</code> \u4ec5\u9002\u7528\u4e8e\u4e34\u65f6\u6392\u67e5\u3002</p> <p>\u8be5\u53c2\u6570\u4f1a\u5173\u95ed TLS \u8bc1\u4e66\u9a8c\u8bc1\uff0c\u4f7f\u8fde\u63a5\u65e0\u6cd5\u53ef\u9760\u5730\u9a8c\u8bc1\u670d\u52a1\u5668\u8eab\u4efd\uff0c\u5b58\u5728\u4e2d\u95f4\u4eba\u653b\u51fb\u98ce\u9669\u3002</p> <p>\u4fee\u590d\u670d\u52a1\u5668 HTTPS \u8bc1\u4e66\u540e\uff0c\u5e94\u7acb\u5373\u79fb\u9664\u6b64\u53c2\u6570\u3002</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/","title":"\u534e\u4e3aMatePad11\u89e3\u9501BL+ROOT+\u5237\u5165GMS","text":"<p>OnePlus13\u624b\u673a\u5b9e\u5728\u662f\u592a\u597d\u7528\u4e86\uff0c\u6700\u4e3b\u8981\u7684\u539f\u56e0\u8fd8\u662f\u539f\u751f\u8c37\u6b4c\u670d\u52a1\uff0c\u4eca\u5e74\u6625\u5929\u6700\u65e9\u662f\u56e0\u4e3a\u624b\u673a\u4e0a\u8fd0\u884c\u6302\u673a\u5c0f\u6e38\u620f\u6709\u70b9\u803d\u8bef\u4e8b\uff0c\u6240\u4ee5\u627e\u51fa\u6765\u4e86\u5e73\u677f\uff0c\u60f3\u5237\u4e00\u4e2a\u8c37\u6b4c\u7cfb\u7edf\uff0c\u66ff\u624b\u673a\u6302\u673a\uff0c\u540e\u6765\u5c0f\u6e38\u620f\u4e0d\u73a9\u4e86\uff0c\u5237\u7cfb\u7edf\u5374\u505a\u4e86\u4e0b\u6765\u3002</p> <p>\u6ce8\u610f</p> <p>\u672c\u6587\u4ec5\u8bb0\u5f55\u4e2a\u4eba\u8bbe\u5907\u4e0a\u7684\u5b9e\u9645\u64cd\u4f5c\u8fc7\u7a0b\uff0c\u4e0d\u4fdd\u8bc1\u53c2\u8003\u8fd9\u4e00\u6559\u7a0b\u80fd\u5237\u673a\u6210\u529f\uff08\uff09</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_1","title":"\u786c\u4ef6\u57fa\u672c\u4fe1\u606f","text":"\u9879\u76ee \u4fe1\u606f \u4ea7\u54c1 HUAWEI MatePad 11 \u578b\u53f7 DBY-W09 \u5730\u533a\u7248\u672c \u4e2d\u56fd\u5927\u9646 C00 \u7f51\u7edc\u7248\u672c Wi-Fi \u7248 EDL Qualcomm Emergency Download Mode 9008"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_2","title":"\u6559\u7a0b\u53ca\u4e3b\u8981\u8def\u7ebf","text":"<p>\u4e3b\u8981\u53c2\u8003\u4e86B\u7ad9\u6559\u7a0b\uff0c\u7528\u9762\u5177Magisk\u5237\u5165\uff0c\u53d1\u73b0\u539f\u6765up\u662f\u9ad8\u4e2d\u751f\uff0c\u534e\u4e3aMatePad 11 2021 \u89e3BL+Root\u6559\u7a0b\u3002</p> <p> </p> <p>\u63a5\u4e0b\u6765\u5728ChatGPT\u7684\u5e2e\u52a9\u4e0b\uff0c\u628aGooglePlay\u7684\u6a21\u5757\u5237\u8fdb\u53bb\u4e86\u3002</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_3","title":"\u5237\u673a\u8fc7\u7a0b\u4e2d\u9047\u5230\u7684\u95ee\u9898","text":""},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#usb","title":"USB\u8bbe\u5907\u4e0d\u8bc6\u522b","text":"<p>\u5907\u4efd\u8fc7\u7a0b\u4e2d\u60f3\u5bfc\u51fa\u6570\u636e\uff0c\u4e00\u5f00\u59cb\u6253\u7b97\u91c7\u7528\u534e\u4e3a\u624b\u673a\u52a9\u624bHiSuite\uff0c\u7535\u8111\u4e0a\u5b89\u88c5\u4e86\u8f6f\u4ef6\u4e4b\u540e\uff0c\u5c31\u4e0d\u8bc6\u522b\u8bbe\u5907\u4e86\uff0cADB\u4e5f\u8fdb\u4e0d\u53bb\uff0c\u5378\u8f7d\u4e4b\u540e\u4f9d\u7136\u8fdb\u4e0d\u53bb\u3002</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_4","title":"\u6392\u67e5\u539f\u56e0","text":"<p>\u68c0\u67e5 Windows USB \u8bbe\u5907\uff1a</p> PowerShell<pre><code>Get-PnpDevice -PresentOnly | Where-Object {\n    $_.InstanceId -like 'USB*'\n} | Format-Table Status,Class,FriendlyName,InstanceId -AutoSize\n</code></pre> <p>\u53d1\u73b0 MatePad \u5bf9\u5e94\u7684 USB Composite Device \u62a5\u9519\uff0c\u786c\u4ef6 ID \u662f:<code>USB\\VID_12D1&amp;PID_107D</code>\uff0c\u95ee\u9898\u7801\u662f <code>Code 39 / CM_PROB_DRIVER_FAILED_LOAD</code>\uff0c\u6700\u7ec8\u5b9a\u4f4d\u5230 HiSuite \u7559\u4e0b\u6765\u7684\u65e7 Huawei USB filter\uff0c\u5176\u4e2dxxx\u662f\u7535\u8111\u7684\u7f16\u53f7\uff1a</p> Text Only<pre><code>oemxxx.inf\n\u539f\u59cb INF\uff1aew_usbccgpfilter.inf\nProvider\uff1aHuawei\nVersion\uff1a1.0.9.0\n</code></pre>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_5","title":"\u89e3\u51b3\u65b9\u6848","text":"<p>\u5728\u7ba1\u7406\u5458 PowerShell\u91cc\u5220\u9664\u8fd9\u4e2a\u9a71\u52a8\u5305\uff0c\u5176\u4e2dxxx\u662f\u7535\u8111\u7684\u7f16\u53f7\uff1a</p> PowerShell<pre><code>pnputil /delete-driver oemxxx.inf /uninstall\n</code></pre> <p>\u91cd\u65b0\u62d4\u63d2USB\u7ebf\uff0cWindows\u5c31\u4f1a\u81ea\u5df1\u679a\u4e3e\u9002\u914d\u9a71\u52a8\u4e86\u3002</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#edl-9008","title":"\u8fdb\u5165 EDL 9008 \u540e\u9ed1\u5c4f","text":"<p>\u5de5\u7a0b\u7ebf\u6210\u529f\u8ba9 DBY-W09 \u8fdb\u5165 EDL \u540e\uff0c\u5e73\u677f\u662f\u7eaf\u9ed1\u5c4f\uff0c\u800c\u4e14ADB\u5de5\u5177\u4e0d\u8bc6\u522b\uff0c\u5413\u6bc1\u4e86\uff0c\u4f46\u662f\u597d\u5728Windows\u80fd\u627e\u5230\u8fd9\u4e2a\u8bbe\u5907 Qualcomm 9008 \u8bbe\u5907\uff0c\u539f\u6765\u53ea\u662f\u6ca1\u6709\u9a71\u52a8\u3002</p>"},{"location":"4OS_and_Server/2PatePad_11/MatePad11_BL_Root_GMS/#_6","title":"\u89e3\u51b3\u65b9\u6848","text":"<p>\u4ece Microsoft Update Catalog \u4e0b\u8f7d</p> Text Only<pre><code>Qualcomm Incorporated\nQualcomm HS-USB QDLoader 9008\nVersion 2.1.1.0\nHardware ID:\nUSB\\VID_05C6&amp;PID_9008\n<